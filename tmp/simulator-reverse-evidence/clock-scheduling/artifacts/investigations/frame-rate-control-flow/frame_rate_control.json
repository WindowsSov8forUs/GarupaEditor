  "managed_control_flow": {
    "refresh_rate_init": [
      "Read Screen.currentResolution.refreshRateRatio numerator and denominator.",
      "Compute numerator / denominator as double and Math.Round(value, 1, ToEven).",
      "Store the rounded value as float DeviceUtility.initDisplayRefreshRate.",
      "Call PluginInterface.RefreshRateInit(max(initDisplayRefreshRate, Application.targetFrameRate))."
    ],
    "set_target_frame_rate": [
      "Set Application.targetFrameRate to the requested integer.",
      "Call PluginInterface.SetRefreshRate(max(initDisplayRefreshRate, requestedFrameRate))."
    ]
  },
  "android_plugin_control_flow": {
    "class_literal": "jp.co.craftegg.band.lib.SetDisplayRefreshRate",
    "init_method_literal": "setRefreshRateInit",
    "update_method_literal": "setRefreshRate",
    "initialization": [
      "Run once on UnityPlayer.currentActivity UI thread when no setter exists.",
      "Find the unitySurfaceView SurfaceView, create RefreshRateSetter, and register it as SurfaceHolder.Callback.",
      "If the current Surface is valid, bind it and apply the requested rate immediately."
    ],
    "surface_lifecycle": [
      "setFrameRate stores the requested float even when no Surface is available.",
      "surfaceCreated binds the Surface and reapplies the stored rate.",
      "surfaceDestroyed clears the Surface reference.",
      "On Android API level 30 or newer, UI-thread work calls Surface.setFrameRate(rate, 0)."
    ]
  },

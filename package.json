{
  "name": "garupa-editor",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run resources:verify-production-assets",
    "preview": "vite preview",
    "chart:test": "node src/chart/testing/runTests.mjs",
    "resources:test": "node src/resources/testing/runTests.mjs",
    "resources:builtin-manifest": "node scripts/build-builtin-resource-catalog.mjs",
    "resources:verify-production-assets": "node scripts/verify-builtin-production-assets.mjs",
    "contracts:audit": "node scripts/audit-runtime-contract-blockers.mjs",
    "contracts:audit:check": "node scripts/audit-runtime-contract-blockers.mjs --check",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "sprites:map": "node ./scripts/build-sprite-source-map.mjs",
    "app:test": "node src/app/testing/run.mjs",
    "test": "node scripts/run-project-tests.mjs --profile development",
    "test:release": "node scripts/run-project-tests.mjs --profile release",
    "simulator:test": "node src/simulator/testing/suite/run.mjs --profile development",
    "simulator:test:portable": "node src/simulator/testing/suite/run.mjs --profile portable",
    "simulator:test:browser": "node src/simulator/testing/suite/run.mjs --profile browser",
    "simulator:test:release": "node src/simulator/testing/suite/run.mjs --profile release",
    "simulator:test:release:clean": "node src/simulator/testing/suite/run.mjs --profile release --clean-browser-build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "pixi.js": "^8.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}

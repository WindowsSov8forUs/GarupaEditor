{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "sprites:map": "node ./scripts/build-sprite-source-map.mjs",
    "test:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-start.ps1",
    "test:start:skip-checks": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-start.ps1 -SkipChecks",
    "test:start:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-start.ps1 -SkipChecks -SmokeTestSeconds 20"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "@tauri-apps/cli": "^2"
  }
}

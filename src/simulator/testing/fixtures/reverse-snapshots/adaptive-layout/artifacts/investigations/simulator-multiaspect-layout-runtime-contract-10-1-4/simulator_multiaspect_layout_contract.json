  "resize_lifecycle": {
    "status": "unsupported-original-complete-refresh-route",
    "findings": [
      "StarUI ScreenWidth/Height getters poll Screen.width/height and setScreenSize recomputes StarUI fields.",
      "RefreshSafeArea is called by Awake and orientation coroutine, not by arbitrary setScreenSize.",
      "RefreshSafeArea reinitializes StarUIScreenToSafeArea, StarUISafeAreaToScreen and StarUIFullScreenTexture only.",
      "ButtonManager.execMultiResolution and particle setup execute during gameplay startup and have no resize caller.",
      "StarUIVerticalFitScreen sets isInitialized and is not part of RefreshSafeArea enumeration.",
      "Therefore no original atomic route refreshes camera-dependent input, gameplay, particles, all UI helpers and MV for an arbitrary mid-live revision."
    ],
    "portable_requirement": "Accept exactly one initial surface state per session. Any later revision, including same-geometry revision, returns evidence-required before commands or input; never continue stale or invent reflow."
  },

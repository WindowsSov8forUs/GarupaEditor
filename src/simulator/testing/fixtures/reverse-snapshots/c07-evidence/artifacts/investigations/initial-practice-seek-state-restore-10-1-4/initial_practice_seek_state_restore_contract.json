  "currentFacts": [
    {
      "id": "IPS-F01",
      "finding": "advanceTime enters GameState 14, hides Judgement and Combo, stops Music, invokes onAdvanceTime with the bounded target seconds, then starts moveTimeToStartMusic."
    },
    {
      "id": "IPS-F02",
      "finding": "onAdvanceTime computes target=floor(current InGameSec)+seconds and repeatedly calls updatePlayState with min(target-current, Float32 0.01666666753590107) until target is reached."
    },
    {
      "id": "IPS-F03",
      "finding": "Current 10.1.4 onAdvanceTime passes updatePlayState isDoubleUpdate=false; this corrects the old 10.1.3 investigation prose. GameState 14 and absent external touch still prevent live user input from becoming initial-seek history."
    },
    {
      "id": "IPS-F04",
      "finding": "updatePlayState advances the ordinary time, NoteManager, judgement/record, CommandNote, skill/stage/effect and display pipeline rather than mutating only chart/audio cursors."
    },
    {
      "id": "IPS-F05",
      "finding": "moveTimeToStartMusic resets transient display/effect owners, increments MoveTime count, loads Music at trunc(InGameSec*1000), refreshes NoteManager after MoveTime and enters state 15 before shared resume reaches state 16."
    },
    {
      "id": "IPS-F06",
      "finding": "Backward ReturnTime restores the compact eleven-field scheduling snapshot, resets Note and CommandNote owners, and reuses advanceTime with hasReturned=true for at most sixteen reconstructed seconds."
    },
    {
      "id": "IPS-F07",
      "finding": "The committed current R1 oracle observes ReturnTime(5), nested NoteManager/CommandNoteManager restoration and aggregate record restoration with a contiguous privacy-minimized trace."
    }
  ],

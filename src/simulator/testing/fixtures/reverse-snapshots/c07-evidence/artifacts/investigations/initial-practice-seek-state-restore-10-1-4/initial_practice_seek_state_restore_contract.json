  "portablePolicies": [
    {
      "id": "IPS-P01",
      "surface": "initial-target",
      "disposition": "Accept one explicit non-negative startMilliseconds strictly inside the explicit chart BGM duration; reject out-of-range values without clamp. Zero retains the ordinary route.",
      "notOriginalFact": "The original rehearsal UI advances by integer seconds and does not expose an initial millisecond launch parameter."
    },
    {
      "id": "IPS-P02",
      "surface": "whole-engine-pre-roll",
      "disposition": "For a non-zero target, initialize one fresh engine at zero, suppress external input/output publication, and replay the ordinary whole-engine pipeline with Float32 deltas no larger than 0x3C888889 plus one exact final remainder to the requested millisecond target.",
      "notOriginalFact": "The final fractional target generalizes the recovered current integer-second loop for the host's explicit millisecond contract."
    },
    {
      "id": "IPS-P03",
      "surface": "state-owners",
      "disposition": "Pre-roll must consume chart/BPM cursors, Note/judgement, score/life/combo, command, chart-owned Skill appearance, render, particle random/owners and lifecycle through normal frame ordering; audio effects remain suppressed during reconstruction.",
      "notOriginalFact": "No audio-only seek or direct chart-time mutation is permitted."
    },
    {
      "id": "IPS-P04",
      "surface": "audio-publication",
      "disposition": "After state reconstruction, publish BGM once at the exact requested seekMilliseconds and expose only the reconstructed final render/particle state; pre-roll SE/BGM commands are not physically emitted.",
      "notOriginalFact": "This is the portable equivalent of current StopMusic -> replay -> LoadMusic(trunc(InGameSec*1000)) -> resume."
    },
    {
      "id": "IPS-P05",
      "surface": "acceptance",
      "disposition": "Compare the non-zero launch snapshot against an independent zero-start no-input continuous replay at the same target across clock, chart cursor, judgement, score/life, render, particle and audio command state; require fresh-session and cleanup isolation.",
      "notOriginalFact": "Portable equality is state/command equality, not CRI device output or GPU framebuffer parity."
    }
  ],

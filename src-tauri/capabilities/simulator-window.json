{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "simulator-window",
  "description": "Capability for simulator windows",
  "windows": ["simulator-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-is-resizable",
    "core:window:allow-set-resizable"
  ]
}
